{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/report",
        "function": {
          "functionId": "report"
        }
      },
      {
        "source": "/snow",
        "function": {
          "functionId": "querySnowflake"
        }
      }
    ]
  },
  "functions": {
    "source": "functions",
    "codebase": "default",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.*.log"
    ],
    "predeploy": [
      "pnpm --prefix \"$RESOURCE_DIR\" run build"
    ]
  }
}
